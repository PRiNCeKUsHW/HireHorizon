# Copy to .env and fill in. .env is gitignored — never commit it.
# HireHorizon sends no email, so there are no SMTP variables here by design.

# Required when DEBUG=False. Generate one with:
#   python manage.py generate_secret_key
SECRET_KEY=

# True only for local development. Never True on a public deployment.
DEBUG=True

# Comma-separated. Required when DEBUG=False.
# For Termux on your LAN, list the phone's IP, e.g. 192.168.1.37,localhost
ALLOWED_HOSTS=

# Comma-separated, scheme included. Needed when serving over HTTPS or through
# a tunnel, e.g. https://your-subdomain.trycloudflare.com
CSRF_TRUSTED_ORIGINS=

# Leave unset to use SQLite at db.sqlite3 (this is what Termux uses).
# Postgres example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Set True ONLY when the site is genuinely served over HTTPS. Turning this on
# over plain http:// forces redirects and makes the site unreachable.
HTTPS_ENABLED=False

# Optional
TIME_ZONE=UTC
PAGE_SIZE=20
LOG_LEVEL=INFO
